<Window x:Class="QuickNote.StackBenchmark.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickNote · WPF benchmark"
        Width="720"
        Height="480"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F4EE">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="20" FontWeight="SemiBold" Text="当前便签" />
        <TextBox x:Name="Editor"
                 Grid.Row="2"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 FontFamily="Segoe UI"
                 FontSize="15"
                 Padding="14"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 SpellCheck.IsEnabled="False" />
        <TextBlock Grid.Row="3"
                   Margin="0,10,0,0"
                   Foreground="#665D54"
                   Text="Ctrl+Alt+Q 呼出 · 250 ms 自动保存 · 关闭窗口仅隐藏" />
    </Grid>
</Window>
