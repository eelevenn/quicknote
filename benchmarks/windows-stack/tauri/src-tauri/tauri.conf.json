{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickNote Stack Tauri",
  "version": "0.1.0",
  "identifier": "dev.quicknote.benchmark.tauri",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
