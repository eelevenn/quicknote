import { AboutSlint, Button, HorizontalBox, LineEdit, TextEdit, VerticalBox } from "std-widgets.slint";

// 主页列表只接收应用模块提供的稳定便签摘要。
export struct NoteListItem {
    id: string,
    title: string,
    is-current: bool,
}

// 主页与快速记录通过同一个应用编辑上下文同步正文和保存状态。
export component MainWindow inherits Window {
    title: "QuickNote";
    // 逻辑像素尺寸在 200% 缩放的 1080p 工作区内仍可完整显示。
    width: 760px;
    height: 520px;
    background: #f7f4ee;

    in-out property <string> editor-body;
    in property <string> editor-title: "空白草稿";
    in property <string> save-status: "空白草稿不会创建便签";
    in property <bool> save-failed: false;
    in-out property <string> shortcut-text: "Ctrl+Alt+Q";
    in property <string> shortcut-status: "全局快捷键已启用";
    in property <[NoteListItem]> note-items;

    callback body-edited(string);
    callback note-selected(string);
    callback new-note();
    callback retry-save();
    callback apply-shortcut(string);
    callback open-quick-capture();
    callback exit-requested();

    VerticalBox {
        padding: 22px;
        spacing: 12px;

        HorizontalBox {
            spacing: 12px;
            VerticalBox {
                spacing: 2px;
                Text {
                    text: "QuickNote";
                    font-size: 27px;
                    font-weight: 700;
                    color: #211d19;
                    accessible-label: "QuickNote 主页";
                }
                Text {
                    text: "当前便签与快速记录共享同一份正文";
                    font-size: 13px;
                    color: #665d54;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "新建便签";
                clicked => { root.new-note(); }
            }
            Button {
                text: "快速记录";
                clicked => { root.open-quick-capture(); }
            }
        }

        HorizontalBox {
            spacing: 12px;
            vertical-stretch: 1;

            Rectangle {
                width: 225px;
                background: #eee8df;
                border-radius: 9px;
                border-color: #d9d0c4;
                border-width: 1px;

                VerticalBox {
                    padding: 10px;
                    spacing: 7px;
                    Text {
                        text: "活跃便签";
                        font-size: 14px;
                        font-weight: 650;
                        color: #403933;
                    }
                    Text {
                        visible: root.note-items.length == 0;
                        text: "还没有已保存便签";
                        font-size: 13px;
                        color: #776e65;
                    }
                    for note in root.note-items : Button {
                        text: (note.is-current ? "● " : "") + (note.title == "" ? "无标题" : note.title);
                        accessible-label: note.is-current ? "当前便签 " + note.title : "便签 " + note.title;
                        clicked => { root.note-selected(note.id); }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            Rectangle {
                background: #fffaf3;
                border-radius: 9px;
                border-color: #d9d0c4;
                border-width: 1px;

                VerticalBox {
                    padding: 14px;
                    spacing: 8px;
                    Text {
                        text: root.editor-title == "" ? "空白草稿" : root.editor-title;
                        font-size: 19px;
                        font-weight: 650;
                        color: #211d19;
                        overflow: elide;
                        accessible-label: "便签标题 " + self.text;
                    }
                    main-editor := TextEdit {
                        text <=> root.editor-body;
                        wrap: word-wrap;
                        font-size: 15px;
                        placeholder-text: "立即记录；标题会从第一条非空行自动生成";
                        accessible-label: "主页便签正文";
                        edited(text) => { root.body-edited(text); }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Text {
                            text: root.save-status;
                            color: root.save-failed ? #9b312b : #2f6b4f;
                            font-size: 13px;
                            accessible-label: root.save-status;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            visible: root.save-failed;
                            text: "重试保存";
                            clicked => { root.retry-save(); }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 68px;
            background: #fffaf3;
            border-radius: 8px;
            border-color: #ded4c7;
            border-width: 1px;
            HorizontalBox {
                padding: 9px;
                spacing: 8px;
                VerticalBox {
                    spacing: 2px;
                    Text { text: "全局快捷键"; font-size: 13px; color: #403933; }
                    LineEdit {
                        text <=> root.shortcut-text;
                        placeholder-text: "例如 Ctrl+Alt+Q";
                        accessible-label: "全局快捷键组合";
                        accepted => { root.apply-shortcut(root.shortcut-text); }
                    }
                }
                Button {
                    text: "应用";
                    clicked => { root.apply-shortcut(root.shortcut-text); }
                }
                Text {
                    text: root.shortcut-status;
                    color: #665d54;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "退出";
                    clicked => { root.exit-requested(); }
                }
            }
        }

        // Royalty-free License 要求保留可见的 Slint attribution。
        AboutSlint { preferred-height: 54px; }
    }

    public function focus-editor-at(offset: int) {
        main-editor.focus();
        main-editor.set-selection-offsets(offset, offset);
    }
}

// 快速记录复用相同正文；保存状态变化不会重设 TextEdit 的选择范围。
export component QuickCaptureWindow inherits Window {
    title: "QuickNote · 快速记录";
    width: 540px;
    height: 320px;
    background: #fffaf3;

    in-out property <string> editor-body;
    in property <string> editor-title: "空白草稿";
    in property <string> save-status: "空白草稿不会创建便签";
    in property <bool> save-failed: false;

    callback body-edited(string);
    callback retry-save();
    callback dismissed();
    callback open-main();

    VerticalBox {
        padding: 20px;
        spacing: 10px;

        Text {
            text: root.editor-title == "" ? "快速记录" : root.editor-title;
            font-size: 20px;
            font-weight: 650;
            color: #211d19;
            overflow: elide;
            accessible-label: "快速记录 " + self.text;
        }

        capture-editor := TextEdit {
            text <=> root.editor-body;
            wrap: word-wrap;
            font-size: 15px;
            placeholder-text: "输入后自动保存";
            accessible-label: "快速记录正文";
            accessible-description: "支持中文输入、粘贴和撤销重做";
            edited(text) => { root.body-edited(text); }
        }

        HorizontalBox {
            spacing: 8px;
            Text {
                text: root.save-status;
                color: root.save-failed ? #9b312b : #2f6b4f;
                font-size: 13px;
                accessible-label: root.save-status;
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                visible: root.save-failed;
                text: "重试";
                clicked => { root.retry-save(); }
            }
            Button {
                text: "主页";
                clicked => { root.open-main(); }
            }
            Button {
                text: "关闭";
                clicked => { root.dismissed(); }
            }
        }
    }

    public function focus-editor-at(offset: int) {
        capture-editor.focus();
        capture-editor.set-selection-offsets(offset, offset);
    }
}
